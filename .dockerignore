# Docker build context excludes for the SC26 AE image.
#
# Mirrors .gitignore. Without this file the build context is ~6.5 GB (raw
# datasets + multi-GB measurement archives) instead of the ~85 MB the artifact
# actually needs. Keep the two files in sync.

# Git metadata (the Zenodo deposit is the archival copy)
.git/
.gitignore

# Raw measurement archives — evidence kept on the AE machine, not shipped.
# Their paths are documented in docs/EXPERIMENTS.md.
artifacts/logs/*archive*/
artifacts/logs/*backup*/
artifacts/baselines/
artifacts/validation/vllm_graphs/reruns/

# Large public datasets are fetched on demand (scripts/fetch_datasets.sh).
# The DERIVED benchmark inputs (spliced / paper-shape jsonls,
# conversation_benchmark) are tracked and MUST stay in the image.
datasets/splitwise/
datasets/azure/
datasets/coco/
datasets/coco_512/
datasets/parti-prompts/
datasets/parti_prompts_1024/
datasets/_outsweep/

# Model weights (fetched or mounted at run time; never baked into the image)
models/
*.pt
*.pth
*.safetensors
*.bin
*.onnx

# C++/CUDA build outputs — rebuilt inside the image
cpp_runtime/build/
build/
dist/

# Python caches and build metadata
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments (the image builds its own)
.venv/
venv/
env/

# IDE / editor / OS cruft
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs and tmp files
*.log
*.tmp
*.tmp.*
core
core.*

# Local secrets / env overrides (never bake into an image)
.env
.env.*
!.env.example
/reviewer_access/
/scripts/admin/
